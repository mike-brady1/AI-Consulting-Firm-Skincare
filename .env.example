# Copy to .env and fill in. NEVER commit .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=

# LiteLLM model names (provider/model). Replace with models your team can access.
# 4 providers: Anthropic, OpenAI and Google generate; Mistral audits (never the same model as a generator).
# To run with 3 providers, drop the gemini entry from GENERATOR_MODELS (GEMINI_API_KEY is then unused).
ORCHESTRATOR_MODEL=anthropic/claude-sonnet-5-5
GENERATOR_MODELS=anthropic/claude-sonnet-5-5,openai/gpt-4o-mini,gemini/gemini-flash-latest
PERSONA_MODEL=openai/gpt-4o-mini
AUDITOR_MODEL=mistral/mistral-large-latest
BASELINE_MODEL=openai/gpt-4o-mini

# Not sent to the Claude 5.5 family, which rejects custom temperatures. See temperature_applied in traces.
TEMPERATURE=0.2
# Sent only to providers that support it (OpenAI, Mistral; not Anthropic). See seed_applied in traces.
SEED=42

# Persona testing: bandit (default) or exhaustive (every compliant scenario x every persona,
# needed once for the offline replay: python src/bandit_eval.py experiments/outputs/<run_id>.json).
PERSONA_MODE=bandit
PERSONA_BUDGET=30          # max persona calls per case (exhaustive = 3 scenarios x 30 personas = 90)
BANDIT_MIN_PULLS=3         # warm-up: every scenario meets this many personas first
BANDIT_CONFIDENCE=0.95     # stop once the leader is this likely to be the best

# Best-of-N baseline: the baseline model drafts BON_N times (default: one per generator), then goes through
# the candidate's selection. Higher temperature so the drafts differ; seeds SEED..SEED+N-1.
BON_N=3
BON_TEMPERATURE=0.7
