# Copy to .env and fill in. NEVER commit .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

# LiteLLM model names (provider/model). Replace with models your team can access.
ORCHESTRATOR_MODEL=anthropic/claude-sonnet-4-5
GENERATOR_MODELS=anthropic/claude-sonnet-4-5,openai/gpt-4o-mini
PERSONA_MODEL=openai/gpt-4o-mini
AUDITOR_MODEL=mistral/mistral-large-latest
BASELINE_MODEL=openai/gpt-4o-mini

TEMPERATURE=0.2
SEED=42
